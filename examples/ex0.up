*/
Test {
  () { }

  foo : Number(775);
}



Main() {
  a : Test();
  a.foo.Print();
  n : Number(776);
  n.Print();

  i : Number(0);
  i++;
  i--;
  i.Print();

  for (i = 10, i > 0, i-- ) {
    i.Print();
  }

  for (j : Number(10); k: Number(775), j > 0, j--; k++ ) {
    j.Print();
    k.Print();
  }
  
}