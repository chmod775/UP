Number {
  Print() {
    this.ToString().Print();
  }
}

SubClass {
  Say() {
    "SubClass".Print();
  }

  () { }
}

HelloClass {
  nn: Number(1111);
  sb: SubClass();

  () { }
  (set: Number) {
    this.nn = set + 1000;
  }


  TestN(cond: Number): HelloClass {
    return.nn = 123;
    
    if (cond < 10) {
      return => HelloClass(888);
      "<10".Print();
      exit;
      "<10.After".Print();
    }
    if (cond > 100) {
      return => HelloClass(999);
      ">10".Print();
      exit;
      ">10.After".Print();
    }

    "After".Print();
  }

  Print() {
    this.nn.Print();
  }
}

Main() {
  cc : HelloClass();
  cc.nn.Print();
  cc.sb.Say();

  c2 : cc.TestN(50);
  c2.nn++;
  c2.Print();

  c3 : cc.TestN(1);
  c3.Print();

  c30 : cc.TestN(300);
  c30.Print();

  c4 : HelloClass(775);
  c4.Print();

}

Main2() {
  n1: Number(3);
  ttt1: n1;
  ttt2: Number => n1;

  n1.Print();
  ttt1.Print();
  ttt2.Print();
}

