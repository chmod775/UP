Actuator {
  name : String("");

/*
  // Setter
  name(val: String) {

  }
  // Getter
  name() {

  }
*/

	Print() {
		this.name.Print();
	}

  (nn : String) {
    this.name = nn + "_Name";
  }

  Assign(act: Actuator) {
    this.name = act.name;
  }
  Assign(num: Number) {
    this.name = "Numb";
  }

  Motor {
		test : Number(123);

//		list: List<Number>(1,2,3,4);
//		dict:	Dictionary<String, List<Number>>();

    maxRPM : Number(1500);

    Pump {
      flow : Number(1);

      (nn : String) {
        this = Actuator(nn + "_Pump");
        //this = Number(123); // Just insanity!
				this.flow = 555;
			}

      GetTotalFlow() : Number {
        return = this.flow + 3.1415;
      }
//			GetTotalFlow(a : Number) : Number {
//				return = this.flow + a;
//			}
			GetTotalFlow(b : Number, a : Number) : Number {
				return = this.flow + b + a;
			}
    }

    Positioner {
      length : Number(2);
    }
  }
}

Actuator.EV {
  monostable : Number(3);
